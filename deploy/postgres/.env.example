# Copy to `.env` next to docker-compose.yml on the NAS and fill it in. `.env` is gitignored: never commit it.

# Passwords: letters and digits only (`openssl rand -hex 24`); MLFLOW_DB_PASSWORD goes into a URL in deploy/mlflow/.
# POSTGRES_PASSWORD is the superuser's (only for you, over `docker exec`); MLFLOW_DB_PASSWORD is the `mlflow` role's and
# must be the same value as in deploy/mlflow/.env. Both are used on the first start, when the data volume is empty.
POSTGRES_PASSWORD=
MLFLOW_DB_PASSWORD=
