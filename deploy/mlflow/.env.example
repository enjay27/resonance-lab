# Copy to `.env` next to docker-compose.yml on the NAS and fill it in. `.env` is gitignored: never commit it.

# The MLflow version of the server. The client in resonance-lab (requirements-*.txt) must be the same version.
MLFLOW_VERSION=3.16.1

# The NAS user that owns the data files (SSH: `id <user>`; the first DSM user is usually 1026:100).
NAS_UID=1026
NAS_GID=100

# The NAS LAN address the server listens on, the port, and the host names a client may use (address:port, comma separated).
MLFLOW_BIND=192.168.0.10
MLFLOW_PORT=5050
MLFLOW_ALLOWED_HOSTS=192.168.0.10:5050

# Where the data lives on the NAS (a local volume, not an SMB/NFS share: SQLite).
MLFLOW_DATA_DIR=/volume1/docker/mlflow/data

# Secrets: a long password for the `admin` user, and a random key (`openssl rand -hex 32`).
MLFLOW_AUTH_ADMIN_PASSWORD=
MLFLOW_FLASK_SERVER_SECRET_KEY=
