# Copy to `.env` next to docker-compose.yml on the NAS and fill it in. `.env` is gitignored: never commit it.
# Start deploy/postgres/ first (README): this server keeps its records in that Postgres.

# The MLflow version of the server. The client in resonance-lab (requirements-*.txt) must be the same version.
MLFLOW_VERSION=3.16.1

# The NAS LAN address the server listens on, the port, and the host names a client may use (address:port, comma separated).
# MLFLOW_BIND must be an address the NAS really has (DSM Control Panel -> Network, or `ip -4 addr` over SSH), else
# docker answers "cannot assign requested address".
MLFLOW_BIND=192.168.0.10
MLFLOW_PORT=5050
MLFLOW_ALLOWED_HOSTS=192.168.0.10:5050

# The password of the `mlflow` role: the same value as MLFLOW_DB_PASSWORD in deploy/postgres/.env. Letters and digits
# only (`openssl rand -hex 24`): it goes into a URL.
MLFLOW_DB_PASSWORD=

# MinIO on the NAS: the endpoint a container can reach (the NAS address, not localhost), the bucket, and an access key
# limited to that bucket (README: not the MinIO root user).
MINIO_ENDPOINT_URL=http://192.168.0.10:9000
MINIO_BUCKET=mlflow
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Secrets: a long password for the `admin` user, and a random key (`openssl rand -hex 32`).
MLFLOW_AUTH_ADMIN_PASSWORD=
MLFLOW_FLASK_SERVER_SECRET_KEY=
