# Copy to `.env.mlflow` in the repo root (gitignored: never commit it). resonance-lab reads it when it logs a run.
# The URL is the NAS LAN address and port from deploy/mlflow/.env; the user is `admin`; the password is the NAS's
# MLFLOW_AUTH_ADMIN_PASSWORD.
MLFLOW_TRACKING_URI=http://192.168.0.10:5050
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=
MLFLOW_DISABLE_TELEMETRY=true
DO_NOT_TRACK=true
