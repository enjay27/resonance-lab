# ==============================================================================
# Resonance-Lab: Final Merged .gitignore
# ==============================================================================

# --- [BPSR PROJECT SPECIFIC] Unsloth & ML Cache ---
# Hardware-specific compiled kernels and training data
unsloth_compiled_cache/
.triton/
lora_dataset/

# --- [BPSR PROJECT SPECIFIC] llama.cpp ---
# Ignore the entire directory if you're using it as a local tool
/llama.cpp/

# --- [BPSR PROJECT SPECIFIC] Machine Learning Artifacts ---
# We never want to push multi-GB weights or GGUFs to GitHub
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx

# --- [BPSR PROJECT SPECIFIC] Research & Build Folders ---
/models/
/outputs/
/datasets/
model_f16/
model_f16_clean/
model_gemma_merged/
# every profile's merged model (merge.yaml export_dir): tokenizer.json and configs are not covered by *.safetensors
model_*_merged/
model_gguf/
BlueProtocol_JP_KO_Translator/
BlueProtocol_JP_KO_Translator-merged-16bit/
# Ignore all files in data, but keep the folder structure
/data/**/*
!/data/**/.gitkeep

# --- [BPSR PROJECT SPECIFIC] Experiment Tracking ---
mlruns/
artifacts/
.mlflow/
# The NAS server's URL and credentials, and the local queue of runs not yet sent to it (see .memory/roadmap/mlflow-plan.md)
deploy/mlflow/.env
deploy/postgres/.env
.env.mlflow
.run.result.backup.json
.run.result.backup.json.migrated
.run.result.backup.json.corrupt-*
.run.result.backup.jsonl
.run.result.backup.jsonl.tmp
.run.result.backup.jsonl.corrupt-*
.run.result.backup.files/

# Executed notebooks: their outputs hold eval lines (players' chat). Commit notebooks with outputs cleared (tests/test_notebooks.py).
notebooks/*.executed.ipynb
.ipynb_checkpoints/

# --- [GITHUB TEMPLATE] Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[codz]
*$py.class
*.so

# --- [GITHUB TEMPLATE] Environments ---
.env
.envrc
.venv
env/
venv/
ENV/

# --- [GITHUB TEMPLATE] Editor & Tooling ---
.idea/
.vscode/
.cursorignore
.cursorindexingignore
# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
